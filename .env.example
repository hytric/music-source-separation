# Docker Compose reads .env. Native start.py reads shell environment variables.
MSS_USE_GPU=0
MSS_SHARE=0
# Set real credentials locally before exposing the server publicly.
MSS_AUTH=
MSS_PORT=7860
MSS_MAX_UPLOAD_MB=100
MSS_MAX_AUDIO_SECONDS=600
MSS_RETENTION_SECONDS=3600
# Optional free VRAM preflight override (GB); defaults: MDX 2, RoFormer 6.
# MSS_MIN_VRAM_GB=6
