    "min_active_free_stem_delta_db": -0.2,
    "min_active_free_stems": 1,
    "max_new_bass_collapse": 0
  },
  "fit": {
    "models": [
      "C_condition_label",
      "Q_quality_label"
    ],
    "primary": "Q_quality_label",
    "l2": 0.01,
    "intercept_penalty": 0,
    "max_newton_iterations": 100,
    "step_max_abs_convergence": 1e-08,
